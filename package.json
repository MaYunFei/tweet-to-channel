    }
  },
  "type": "module",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.3",
    "grammy": "^1.46.0",
    "react": "^19.3.0",
    "satori": "^0.33.5",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
