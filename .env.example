# ==========================================
# Tweet to Image Telegram Bot Configuration
# ==========================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
# Required
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram User IDs allowed to use the bot
# Comma-separated list or JSON array: e.g. 123456789,987654321
# Leave empty to allow anyone (not recommended for private bots)
ADMIN_USER_IDS=

# Target Telegram Channel to publish images to
# e.g. @your_channel or -1001234567890
# Leave empty if you only want the bot to reply images in private chat
TARGET_CHANNEL_ID=@your_channel

# Tweet card visual theme: 'dark' | 'dim' | 'light'
THEME=dark

# Optional HTTP/HTTPS/SOCKS5 proxy (e.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# Helpful if your server is located in Mainland China and needs proxy to reach Telegram / Twitter
PROXY_URL=

# Whether to also send the generated photo back to admin in private chat (true / false)
SEND_TO_ADMIN=true

# Hashtag appended to Telegram caption (perfect for BroadcastChannel tag indexing)
TAG=#Twitter
