# ==========================================
# Tweet to Channel Telegram Bot Configuration
# ==========================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
# Required
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram User IDs allowed to use the bot
# Comma-separated list or JSON array: e.g. 123456789,987654321
# Leave empty to allow anyone (not recommended for private bots)
ADMIN_USER_IDS=

# Target Telegram Channel(s) to publish to
# e.g. @your_channel or -1001234567890
# Supports multiple channels separated by commas: e.g. @channel1,-1001234567890,@channel2
# Leave empty if you only want the bot to reply in private chat
TARGET_CHANNEL_ID=@your_channel

# Tweet card visual theme: 'dark' | 'dim' | 'light'
THEME=dark

# Video handling mode:
# - 'video' (recommended): Downloads high-res MP4 and posts as native Telegram video (playable in BroadcastChannel!)
# - 'card': Always renders a tweet card image (with video poster + play button overlay)
# - 'both': Posts both the card image and the native video
VIDEO_MODE=video

# Optional HTTP/HTTPS/SOCKS5 proxy (e.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# Helpful if your server is located in Mainland China and needs proxy to reach Telegram / Twitter
PROXY_URL=

# Whether to also send the media back to admin in private chat (true / false)
SEND_TO_ADMIN=true

# Hashtag appended to Telegram caption (perfect for BroadcastChannel tag indexing)
TAG=#Twitter

# Whether to enable bilingual translation by default (free Google Translate API, zero key required)
# Automatically translates non-Chinese tweets into Chinese in cards and Telegram captions
ENABLE_TRANSLATION=true

# Whether to attach original high-res photos alongside card image as a Telegram album (true / false)
# When true, tweets with photos are posted as a MediaGroup: [Card, Photo 1, Photo 2...]
ATTACH_PHOTOS=true

# Whether to automatically blur sensitive / NSFW / adult media with Telegram spoiler (true / false)
# When true, tweets flagged as sensitive/NSFW will have the Telegram sparkling blur cover applied
ENABLE_SPOILER=true

# Optional self-hosted Telegram Bot API server root URL
# Defaults to official https://api.telegram.org (50MB upload limit).
# If you run a local `telegram-bot-api` instance (e.g. http://localhost:8081),
# setting this increases the video upload limit to 2000MB (2GB)!
TELEGRAM_API_ROOT=

# ==========================================
# HTTP API Server (iOS Shortcuts / Webhooks)
# ==========================================

# Port for the built-in HTTP API server (default: 3000)
API_PORT=3000

# Secret Token for API authentication (Bearer token or ?token=...)
# Required for /api/publish endpoint (e.g. for iOS Shortcuts share sheet)
API_AUTH_TOKEN=your_custom_secret_token_here

# Whether to enable the HTTP API server (true / false, default: true)
ENABLE_API=true

